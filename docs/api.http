### Risk Audit Management System - API Testing File
### Base URL
@baseUrl = http://10.51.74.29:8050
@accessToken = your_jwt_token_here

###############################################################################
# HEALTH CHECK
###############################################################################

### Check Service Health
GET {{baseUrl}}/health

###############################################################################
# AUTHENTICATION (PUBLIC)
###############################################################################

### Register New User
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "john.doe",
  "email": "john.doe@example.com",
  "password": "securepassword123!",
  "first_name": "John",
  "last_name": "Doe",
  "branch_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef",
  "department_id": "b2c3d4e5-f6a7-4890-2345-67890abcdef1",
  "role_id": "c3d4e5f6-a7b8-4901-3456-7890abcdef12"
}

### Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin@123"
}

### Change Password (Protected)
POST {{baseUrl}}/api/v1/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "old_password": "current_secure_password",
  "new_password": "new_very_secure_password"
}

###############################################################################
# PROVINCE MANAGEMENT
###############################################################################

### Create Province
POST {{baseUrl}}/api/v1/provinces
Content-Type: application/json

{
  "name": "Harare",
  "code": "HRE"
}

### List All Provinces
GET {{baseUrl}}/api/v1/provinces

### List Active Provinces
GET {{baseUrl}}/api/v1/provinces?is_active=true

### Get Province by ID
GET {{baseUrl}}/api/v1/provinces/a1b2c3d4-e5f6-4789-1234-567890abcdef

### Get Provinces with Towns (Nested)
GET {{baseUrl}}/api/v1/provinces/with-towns

###############################################################################
# TOWN MANAGEMENT
###############################################################################

### Create Town
POST {{baseUrl}}/api/v1/towns
Content-Type: application/json

{
  "name": "Harare",
  "code": "HRE",
  "province_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef"
}

### List All Towns
GET {{baseUrl}}/api/v1/towns

### List Towns by Province
GET {{baseUrl}}/api/v1/towns?province_id=a1b2c3d4-e5f6-4789-1234-567890abcdef

### List Active Towns
GET {{baseUrl}}/api/v1/towns?is_active=true

###############################################################################
# BRANCH MANAGEMENT
###############################################################################

### List All Branches
GET {{baseUrl}}/api/v1/branches

### List Branches with Filters
GET {{baseUrl}}/api/v1/branches?province_id=b2c3d4e5-f6a7-4890-2345-67890abcdef1&is_active=true&limit=10

### Create Branch
POST {{baseUrl}}/api/v1/branches
Content-Type: application/json

{
  "name": "Harare Branch",
  "code": "HRE",
  "town_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef",
  "province_id": "b2c3d4e5-f6a7-4890-2345-67890abcdef1",
  "address": "123 Main Street",
  "province": "Central",
  "town": "Harare",
  "is_active": true
}

### Get Branch by ID
GET {{baseUrl}}/api/v1/branches/a1b2c3d4-e5f6-4789-1234-567890abcdef

### Update Branch
PUT {{baseUrl}}/api/v1/branches/a1b2c3d4-e5f6-4789-1234-567890abcdef
Content-Type: application/json

{
  "name": "Harare Central Branch",
  "code": "HRE-C",
  "town_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef",
  "province_id": "b2c3d4e5-f6a7-4890-2345-67890abcdef1",
  "address": "456 Main Street, Harare",
  "is_active": true
}

### Delete Branch
DELETE {{baseUrl}}/api/v1/branches/a1b2c3d4-e5f6-4789-1234-567890abcdef

###############################################################################
# DEPARTMENT MANAGEMENT
###############################################################################

### List All Departments
GET {{baseUrl}}/api/v1/departments

### List Departments with Filters
GET {{baseUrl}}/api/v1/departments?is_active=true&limit=20

### List Sub-Departments
GET {{baseUrl}}/api/v1/departments?parent_id=b2c3d4e5-f6a7-4890-2345-67890abcdef1

### Create Department
POST {{baseUrl}}/api/v1/departments
Content-Type: application/json

{
  "name": "Internal Audit",
  "code": "IA",
  "description": "Internal Audit Department",
  "parent_id": null
}

### Create Sub-Department
POST {{baseUrl}}/api/v1/departments
Content-Type: application/json

{
  "name": "IT Audit",
  "code": "ITA",
  "description": "IT Audit Sub-Department",
  "parent_id": "b2c3d4e5-f6a7-4890-2345-67890abcdef1"
}

### Get Department by ID
GET {{baseUrl}}/api/v1/departments/b2c3d4e5-f6a7-4890-2345-67890abcdef1

### Update Department
PUT {{baseUrl}}/api/v1/departments/b2c3d4e5-f6a7-4890-2345-67890abcdef1
Content-Type: application/json

{
  "name": "Internal Audit & Risk",
  "code": "IAR",
  "description": "Combined Internal Audit and Risk Department",
  "parent_id": null,
  "is_active": true
}

### Delete Department
DELETE {{baseUrl}}/api/v1/departments/b2c3d4e5-f6a7-4890-2345-67890abcdef1

### Get Department Modules
GET {{baseUrl}}/api/v1/departments/b2c3d4e5-f6a7-4890-2345-67890abcdef1/modules

### Assign Module to Department
POST {{baseUrl}}/api/v1/departments/b2c3d4e5-f6a7-4890-2345-67890abcdef1/modules
Content-Type: application/json

{
  "module_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef"
}

### Remove Module from Department
DELETE {{baseUrl}}/api/v1/departments/b2c3d4e5-f6a7-4890-2345-67890abcdef1/modules/a1b2c3d4-e5f6-4789-1234-567890abcdef

### Get Department Risk Categories
GET {{baseUrl}}/api/v1/departments/b2c3d4e5-f6a7-4890-2345-67890abcdef1/risk-categories

###############################################################################
# MODULE MANAGEMENT
###############################################################################

### List All Modules (Flat)
GET {{baseUrl}}/api/v1/modules

### List Modules (Hierarchical)
GET {{baseUrl}}/api/v1/modules?hierarchy=true

### Create Parent Module
POST {{baseUrl}}/api/v1/modules
Content-Type: application/json

{
  "module_code": "USER_MGMT",
  "name": "User Management",
  "description": "Manage system users",
  "parent_module_id": null,
  "href": null,
  "icon": "users",
  "sort_order": 1
}

### Create Sub-Module
POST {{baseUrl}}/api/v1/modules
Content-Type: application/json

{
  "module_code": "USER_CREATE",
  "name": "Create User",
  "description": "Create new system users",
  "parent_module_id": "c3d4e5f6-a7b8-4901-3456-7890abcdef12",
  "href": "/users/create",
  "icon": "user-plus",
  "sort_order": 1
}

### Get Module by ID
GET {{baseUrl}}/api/v1/modules/c3d4e5f6-a7b8-4901-3456-7890abcdef12

### Update Module
PUT {{baseUrl}}/api/v1/modules/c3d4e5f6-a7b8-4901-3456-7890abcdef12
Content-Type: application/json

{
  "module_code": "USER_MGMT_UPD",
  "name": "User Management Updated",
  "description": "Updated description",
  "parent_module_id": null,
  "href": "/users",
  "icon": "users",
  "sort_order": 1,
  "is_active": true
}

### Delete Module
DELETE {{baseUrl}}/api/v1/modules/c3d4e5f6-a7b8-4901-3456-7890abcdef12

### Get Sub-Modules
GET {{baseUrl}}/api/v1/modules/c3d4e5f6-a7b8-4901-3456-7890abcdef12/submodules

###############################################################################
# ROLE MANAGEMENT
###############################################################################

### List All Roles
GET {{baseUrl}}/api/v1/roles

### List Roles with Filters
GET {{baseUrl}}/api/v1/roles?department_id=b2c3d4e5-f6a7-4890-2345-67890abcdef1&is_active=true

### Create Role
POST {{baseUrl}}/api/v1/roles
Content-Type: application/json

{
  "department_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef",
  "name": "Auditor",
  "code": "AUDITOR",
  "description": "Standard auditor role"
}

### Get Role by ID
GET {{baseUrl}}/api/v1/roles/c3d4e5f6-a7b8-4901-3456-7890abcdef12

### Update Role
PUT {{baseUrl}}/api/v1/roles/c3d4e5f6-a7b8-4901-3456-7890abcdef12
Content-Type: application/json

{
  "name": "Senior Auditor",
  "code": "SR_AUDITOR",
  "description": "Senior auditor role",
  "is_active": true
}

### Delete Role
DELETE {{baseUrl}}/api/v1/roles/c3d4e5f6-a7b8-4901-3456-7890abcdef12

### Get Role Permissions
GET {{baseUrl}}/api/v1/roles/c3d4e5f6-a7b8-4901-3456-7890abcdef12/permissions

### Grant or Update Permission to Role
POST {{baseUrl}}/api/v1/roles/c3d4e5f6-a7b8-4901-3456-7890abcdef12/permissions
Content-Type: application/json

{
  "module_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef",
  "can_view": true,
  "can_create": true,
  "can_edit": true,
  "can_delete": false,
  "can_approve": false,
  "can_export": true,
  "can_assign": false,
  "can_configure": false,
  "custom_permissions": {
    "can_run_reports": true
  }
}

### Revoke Permission from Role
DELETE {{baseUrl}}/api/v1/roles/c3d4e5f6-a7b8-4901-3456-7890abcdef12/permissions/a1b2c3d4-e5f6-4789-1234-567890abcdef

### Get Available Modules for Role
GET {{baseUrl}}/api/v1/roles/c3d4e5f6-a7b8-4901-3456-7890abcdef12/available-modules

