###############################################################################
# KRI (KEY RISK INDICATOR) MANAGEMENT (PROTECTED)
###############################################################################

### List KRIs
GET {{baseUrl}}/api/v1/kris
Authorization: Bearer {{accessToken}}

### List KRIs with Filters
GET {{baseUrl}}/api/v1/kris?category_id=a1b2c3d4-e5f6-4789-1234-567890abcdef&last_status=Amber&limit=20
Authorization: Bearer {{accessToken}}

### Create KRI
POST {{baseUrl}}/api/v1/kris
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Customer Retention Rate",
  "description": "Percentage of customers retained annually",
  "kri_register_id": "h8i9j0k1-l2m3-6789-0123-4ef567890bcd",
  "category_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef",
  "department_id": "b2c3d4e5-f6a7-4890-2345-67890abcdef1",
  "target_value": "95%",
  "trigger_value": "90% ≥ but > 85%",
  "limit_value": "85%",
  "monitoring_frequency": "Monthly",
  "owner_id": "c3d4e5f6-a7b8-4901-3456-7890abcdef12",
  "commentary": "Initial setup for customer retention tracking",
  "mitigant_plan": "Implement customer feedback survey quarterly"
}

### Get KRI by ID
GET {{baseUrl}}/api/v1/kris/i9j0k1l2-m3n4-7890-1234-5fg678901cde
Authorization: Bearer {{accessToken}}

### Update KRI
PUT {{baseUrl}}/api/v1/kris/i9j0k1l2-m3n4-7890-1234-5fg678901cde
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Customer Retention Rate",
  "description": "Updated description",
  "target_value": "10%",
  "trigger_value": "9.5% ≥ but > 9%",
  "limit_value": "8.8%",
  "monitoring_frequency": "Monthly",
  "commentary": "Updated commentary after Q1 review",
  "mitigant_plan": "Enhanced action plan with quarterly reviews",
  "is_active": true
}

### Delete KRI
DELETE {{baseUrl}}/api/v1/kris/i9j0k1l2-m3n4-7890-1234-5fg678901cde
Authorization: Bearer {{accessToken}}

### Add KRI Measurement
POST {{baseUrl}}/api/v1/kris/i9j0k1l2-m3n4-7890-1234-5fg678901cde/measurements
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "measurement_date": "2025-01-31T00:00:00Z",
  "measured_value": 94.0,
  "status": "Green",
  "notes": "January performance exceeded target",
  "measured_by": "c3d4e5f6-a7b8-4901-3456-7890abcdef12"
}

### Get KRI Measurements
GET {{baseUrl}}/api/v1/kris/i9j0k1l2-m3n4-7890-1234-5fg678901cde/measurements
Authorization: Bearer {{accessToken}}

### Get KRI Measurements with Date Range
GET {{baseUrl}}/api/v1/kris/i9j0k1l2-m3n4-7890-1234-5fg678901cde/measurements?start_date=2025-01-01&end_date=2025-03-31
Authorization: Bearer {{accessToken}}

### Get Active KRIs Due for Measurement
GET {{baseUrl}}/api/v1/kris/due-measurement
Authorization: Bearer {{accessToken}}

### Get Active KRIs Due for Measurement (Specific Date)
GET {{baseUrl}}/api/v1/kris/due-measurement?as_of_date=2025-02-15
Authorization: Bearer {{accessToken}}

### Get KRI Status Summary
GET {{baseUrl}}/api/v1/kris/status-summary
Authorization: Bearer {{accessToken}}

### Get KRI Status Summary by Department
GET {{baseUrl}}/api/v1/kris/status-summary?department_id=b2c3d4e5-f6a7-4890-2345-67890abcdef1
Authorization: Bearer {{accessToken}}

