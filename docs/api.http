###############################################################################
# RISK MANAGEMENT (PROTECTED)
###############################################################################

### List All Risks
GET {{baseUrl}}/api/v1/risks
Authorization: Bearer {{accessToken}}

### List Risks with Filters
GET {{baseUrl}}/api/v1/risks?status=OPEN&inherent_rating=HIGH&limit=10
Authorization: Bearer {{accessToken}}

### Create Risk
POST {{baseUrl}}/api/v1/risks
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Cyber Security Breach Risk",
  "description": "Potential unauthorized access to sensitive company data",
  "category_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef",
  "department_id": "b2c3d4e5-f6a7-4890-2345-67890abcdef1",
  "inherent_likelihood": 4,
  "inherent_impact": 5,
  "residual_likelihood": 2,
  "residual_impact": 3,
  "existing_controls": "Firewall, antivirus software, employee training",
  "control_effectiveness": 3,
  "treatment_plan": "Implement multi-factor authentication",
  "risk_response": "REDUCE",
  "risk_owner_id": "c3d4e5f6-a7b8-4901-3456-7890abcdef12",
  "risk_appetite_status": "WITHIN",
  "target_closing_date": "2025-12-31",
  "review_date": "2025-11-30",
  "mitigation_cost": 50000.00
}

### Get Risk by ID
GET {{baseUrl}}/api/v1/risks/f6a7b8c9-d0e1-4234-6789-0abcdef12345
Authorization: Bearer {{accessToken}}

### Update Risk
PUT {{baseUrl}}/api/v1/risks/f6a7b8c9-d0e1-4234-6789-0abcdef12345
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Updated Cyber Security Risk",
  "description": "Updated description with more details",
  "residual_likelihood": 1,
  "residual_impact": 2,
  "latest_update": "MFA fully implemented across all departments",
  "status": "CLOSED",
  "date_closed": "2025-10-25",
  "revised_target_date": "2025-10-30"
}

### Delete Risk
DELETE {{baseUrl}}/api/v1/risks/f6a7b8c9-d0e1-4234-6789-0abcdef12345
Authorization: Bearer {{accessToken}}

### Get Risk Matrix
GET {{baseUrl}}/api/v1/risks/matrix
Authorization: Bearer {{accessToken}}

###############################################################################
# RISK REGISTER MANAGEMENT (PROTECTED)
###############################################################################

### Initialize Risk Register
POST {{baseUrl}}/api/v1/risk-registers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "branch_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef",
  "name": "Q1 2025 Risk Assessment",
  "start_date": "2025-01-01",
  "due_date": "2025-03-31"
}

### Get All Risk Registers
GET {{baseUrl}}/api/v1/risk-registers
Authorization: Bearer {{accessToken}}

### Get Risk Registers with Filters
GET {{baseUrl}}/api/v1/risk-registers?branch_id=a1b2c3d4-e5f6-4789-1234-567890abcdef&status=OPEN&page=1&page_size=20
Authorization: Bearer {{accessToken}}

### Get Risk Register by ID
GET {{baseUrl}}/api/v1/risk-registers/f6a7b8c9-d0e1-4234-6789-0abcdef12345
Authorization: Bearer {{accessToken}}

### Update Risk Register
PUT {{baseUrl}}/api/v1/risk-registers/f6a7b8c9-d0e1-4234-6789-0abcdef12345
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Q1 2025 Risk Assessment - Updated",
  "start_date": "2025-01-01",
  "due_date": "2025-04-15",
  "status": "OPEN"
}

### Close Risk Register
POST {{baseUrl}}/api/v1/risk-registers/f6a7b8c9-d0e1-4234-6789-0abcdef12345/close
Authorization: Bearer {{accessToken}}

### Delete Risk Register
DELETE {{baseUrl}}/api/v1/risk-registers/f6a7b8c9-d0e1-4234-6789-0abcdef12345
Authorization: Bearer {{accessToken}}

### Get Risk Registers by Branch
GET {{baseUrl}}/api/v1/branches/a1b2c3d4-e5f6-4789-1234-567890abcdef/risk-registers
Authorization: Bearer {{accessToken}}

###############################################################################
# MULTI-STEP RISK CREATION WORKFLOW (PROTECTED)
###############################################################################

### Step 1: Create Risk Details
POST {{baseUrl}}/api/v1/risks/step-one
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "risk_register_id": "f6a7b8c9-d0e1-4234-6789-0abcdef12345",
  "title": "Data Center Power Failure",
  "description": "Risk of prolonged power outage affecting critical services",
  "category_id": "a1b2c3d4-e5f6-4789-1234-567890abcdef",
  "department_id": "b2c3d4e5-f6a7-4890-2345-67890abcdef1",
  "macro_process": "Infrastructure Management",
  "sub_process": "Power Management",
  "strategic_objective": "Ensure 99.9% uptime for critical systems",
  "root_cause": "Aging UPS systems and lack of generator redundancy",
  "recurrence": "ongoing"
}

### Step 2: Add Risk Evaluation
PUT {{baseUrl}}/api/v1/risks/g7h8i9j0-k1l2-5678-9012-3def456789ab/step-two
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "inherent_likelihood": 4,
  "inherent_impact": 5,
  "existing_controls": "UPS systems, backup generator, monitoring systems",
  "control_effectiveness": 2
}

### Step 3: Complete Risk Response
PUT {{baseUrl}}/api/v1/risks/g7h8i9j0-k1l2-5678-9012-3def456789ab/step-three
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "residual_likelihood": 2,
  "residual_impact": 3,
  "treatment_plan": "Upgrade UPS systems, install redundant generators, implement predictive maintenance",
  "risk_response": "REDUCE",
  "risk_owner_id": "c3d4e5f6-a7b8-4901-3456-7890abcdef12",
  "risk_appetite_status": "WITHIN",
  "target_closing_date": "2025-12-31",
  "mitigation_cost": 250000.00
}

### Get Risks in Register
GET {{baseUrl}}/api/v1/risk-registers/f6a7b8c9-d0e1-4234-6789-0abcdef12345/risks
Authorization: Bearer {{accessToken}}

### Update Risk Status
PUT {{baseUrl}}/api/v1/risks/g7h8i9j0-k1l2-5678-9012-3def456789ab/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "CLOSED"
}

### Submit Department Risks
POST {{baseUrl}}/api/v1/risk-registers/f6a7b8c9-d0e1-4234-6789-0abcdef12345/departments/b2c3d4e5-f6a7-4890-2345-67890abcdef1/submit
Authorization: Bearer {{accessToken}}

